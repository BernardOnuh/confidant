# OpenRouter: one key reaches every contestant model (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Throwaway TESTNET wallet that pays Telegraph. `npm run wallet` creates one and fills this in.
EVM_PRIVATE_KEY=
# eip155:11155111 = Ethereum Sepolia (default, failed calls refunded to escrow), eip155:84532 = Base Sepolia
PAY_NETWORK=eip155:11155111

# Optional
# MODELS=anthropic/claude-sonnet-5.5,openai/gpt-6.1-terra
# QUESTIONS_PER_ROUND=9
# ROUND_EVERY_MIN=180          # run a round on a schedule while the server is up
# DAILY_BUDGET_USD=5           # stop buying from Telegraph once today's spend hits this
# MAX_PRICE_PER_CALL=50000     # hard cap per purchase, 6-decimal USDC (50000 = $0.05)
# MISTAKE_COST_USD=0.25        # what a wrong answer costs, as told to every model
# NVD_API_KEY=                 # faster CVE lookups (https://nvd.nist.gov/developers/request-an-api-key)
# TRY_PER_HOUR=3               # questions each visitor may ask per hour (your own network is not limited)
# HOST=127.0.0.1               # 0.0.0.0 to open it to other devices
# PORT=8800
